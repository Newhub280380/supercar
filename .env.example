DATABASE_URL=postgresql://user:password@localhost:5432/cosmetology_db
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI Cosmetology Platform"

# OpenAI / LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=30000

# Logging level: debug | info | warn | error
LOG_LEVEL=info

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Письма не отправляются, пока ключ пустой. Заглушка «успех» не возвращается.
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="AI Cosmetology Platform"

# Входящий вебхук Wazzup (WhatsApp). Токен отдаётся в заголовке x-wazzup-token
WAZZUP_WEBHOOK_TOKEN=

# Токен для внешней выгрузки лидов в /api/leads (заголовок x-ingest-token)
LEADS_INGEST_TOKEN=

# Демо-пользователь для npm run db:seed:demo
DEMO_EMAIL=demo@beautyarts.org
DEMO_PASSWORD=Demo12345!
